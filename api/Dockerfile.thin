# The GPU image actually deployed (fooser/esp32-homeai-api:cuda-tools): this repo's app/ plus the newer Python deps,
# as one thin layer (~75 MB) on top of the full :cuda image, so the GPU node doesn't pull another ~12 GB:
#   docker build -f Dockerfile.thin -t fooser/esp32-homeai-api:cuda-tools .
# The main Dockerfile installs the same requirements.txt from scratch (one ~12 GB layer with torch).
FROM fooser/esp32-homeai-api@sha256:88a3d4212644ab49533735db3da015b87d294c37f159db3870bdd2cbf0117296
USER root
# Upstream qwen-tts first: qwen-tts-hf ships the same `qwen_tts` package, and uninstalling afterwards would delete it.
# torch/torchaudio pinned so the resolver keeps the image's CUDA build. Versions match requirements.txt.
RUN uv pip uninstall --system qwen-tts \
 && uv pip install --system --no-cache "faster-qwen3-tts==0.5.4" "qwen-tts-hf==0.1.1.post1" "transformers==5.15.1" \
      "shazamio==0.8.1" "torch==2.9.1" "torchaudio==2.9.1"
COPY --chown=app app/ app/
USER app
