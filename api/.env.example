# Copy to .env and adjust. All values are optional; defaults shown here.

# --- LLM: your existing OpenAI-compatible endpoint ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=llama3.2
LLM_TIMEOUT_S=120
# Ollama only: 0 = unload the model after each reply (frees RAM for the voice on small machines)
LLM_KEEP_ALIVE=
# SYSTEM_PROMPT="You are Rocky, an Eridian engineer..."   (default: Rocky's personality, see app/config.py)

# --- STT (faster-whisper) ---
# tiny | base | small | medium | large-v3  (bigger = better + slower)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu          # or: cuda
WHISPER_COMPUTE_TYPE=int8   # cpu: int8 | cuda: float16
WHISPER_LANGUAGE=           # e.g. en — empty = auto-detect (Rocky speaks English; en recommended)

# --- TTS: Rocky's voice (Qwen3-TTS Base, zero-shot clone) ---
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
TTS_DEVICE=cpu              # or: cuda (bf16; install the cu128 torch wheels)
# Reference clip + exact transcript, copied by scripts/get_rocky_voice.sh
TTS_REF_AUDIO=rocky/rocky_ref.wav
TTS_REF_TEXT=rocky/rocky_ref.txt
TTS_TEMPERATURE=0.9
# English | Spanish | ... (Qwen3-TTS languages). Rocky was tuned in English.
TTS_LANGUAGE=English

# --- Output WAV shaped for the ESP32 ---
OUTPUT_SAMPLE_RATE=16000
