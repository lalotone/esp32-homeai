# Copy to .env and adjust. All values are optional; defaults shown here.

# --- LLM: your existing OpenAI-compatible endpoint ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=llama3.2
LLM_TIMEOUT_S=120
# SYSTEM_PROMPT="You are a helpful voice assistant..."

# --- STT (faster-whisper) ---
# tiny | base | small | medium | large-v3  (bigger = better + slower)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu          # or: cuda
WHISPER_COMPUTE_TYPE=int8   # cpu: int8 | cuda: float16
WHISPER_LANGUAGE=           # e.g. en — empty = auto-detect

# --- TTS (Piper) ---
# The piper executable from scripts/download_piper.sh, or "piper" if on PATH.
PIPER_BIN=piper/piper
# A .onnx voice; its <name>.onnx.json must sit beside it.
PIPER_MODEL=voices/en_US-lessac-medium.onnx

# --- Output WAV shaped for the ESP32 ---
OUTPUT_SAMPLE_RATE=16000
