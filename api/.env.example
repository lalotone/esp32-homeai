# Copy to .env and adjust. All values are optional; defaults shown here.

# --- LLM: your existing OpenAI-compatible endpoint ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=llama3.2
LLM_TIMEOUT_S=120
# Ollama only: 0 = unload the model after each reply (frees RAM for the voice on small machines)
LLM_KEEP_ALIVE=
# vLLM + Qwen3 thinking models: false = no reasoning step (much faster replies). Empty = model default
LLM_ENABLE_THINKING=
# SYSTEM_PROMPT="You are Rocky, an Eridian engineer..."   (default: Rocky's personality, see app/config.py)

# --- STT (faster-whisper) ---
# tiny | base | small | medium | large-v3  (bigger = better + slower)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu          # or: cuda
WHISPER_COMPUTE_TYPE=int8   # cpu: int8 | cuda: float16
WHISPER_LANGUAGE=           # e.g. en — empty = auto-detect (Rocky speaks English; en recommended)
# Words Whisper should expect, e.g. local place names it otherwise mishears ("Zaragoza" -> "Maragona")
WHISPER_PROMPT=

# --- TTS: Rocky's voice (Qwen3-TTS Base, zero-shot clone) ---
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
TTS_DEVICE=cpu              # or: cuda (bf16; install the cu128 torch wheels)
# GPU engine: faster = faster-qwen3-tts (CUDA graphs, ~4x faster) | qwen = plain qwen_tts. The CPU always uses qwen.
TTS_ENGINE=faster
# Reference clip + exact transcript, copied by scripts/get_rocky_voice.sh
TTS_REF_AUDIO=rocky/rocky_ref.wav
TTS_REF_TEXT=rocky/rocky_ref.txt
TTS_TEMPERATURE=0.9
# English | Spanish | ... (Qwen3-TTS languages). Rocky was tuned in English.
TTS_LANGUAGE=English

# --- Output WAV shaped for the ESP32 ---
OUTPUT_SAMPLE_RATE=16000

# --- Input silence gate ---
# The firmware uploads whatever it captured after a wake (even pure silence). The API
# measures the recording's RMS and, if below this level (dBFS, 0 = full scale), skips
# STT/LLM/TTS and returns a short silent reply. Higher = stricter. The RMS covers the whole
# clip (lead-in silence included): real speech via the board is -45..-48 dBFS, so keep it
# at or below the firmware's VAD level (-55).
SILENCE_THRESHOLD_DBFS=-55
# Seconds of silent "nothing heard" reply the ESP32 plays back.
SILENCE_REPLY_SECONDS=0.4

# --- Conversation memory: follow-ups like "and tomorrow?" (0 turns = every question stands alone) ---
HISTORY_TURNS=4
HISTORY_TTL_S=300

# --- LLM tools (app/tools.py): time, weather, news, math, Wikipedia, timers/alarms/reminders,
# shopping list, morning briefing, song recognition, Telegram, homelab status. These call
# outside services (see README "Privacy"); false = none of them.
TOOLS_ENABLED=true
# Home: default place for the weather, and the timezone for the clock/alarms
HOME_NAME=Madrid
HOME_LAT=40.4168
HOME_LON=-3.7038
HOME_TZ=Europe/Madrid
# The news tool's "local" region: comma-separated RSS URLs and a name. Empty = no local news.
LOCAL_NEWS_FEEDS=
LOCAL_NEWS_NAME=
# Where timers, alarms, reminders and the shopping list are kept (alerts.json, shopping.json)
STATE_DIR=state
# "Send it to my phone": a Telegram bot token (@BotFather) and YOUR chat id, the only recipient.
# Secret: keep it in .env (gitignored) or a Kubernetes Secret, never in git. Empty = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Homelab status tool (Kubernetes only: needs a ServiceAccount that can list nodes/pods/deployments):
# DCGM exporter metrics URL for GPU stats, and a path on the GPU node's disk. Empty = skip.
HOMELAB_DCGM_URL=
HOMELAB_DISK_PATH=
